# Doxyfile pour la génération XML consommée par Breathe/Sphinx.
# Exécuter depuis Doc/sphinx/source :  doxygen Doxyfile

PROJECT_NAME           = "EOS"
OUTPUT_DIRECTORY       = doxygen
CREATE_SUBDIRS         = NO

# --- Entrées -----------------------------------------------------------------
INPUT                  = ../../../Modules/EOS/API \
                         ../../../Modules/EOS/Src/EOS_Mixing.hxx \
                         ../../../Modules/EOS_IGen/API \
                         ../../../Modules/Functions/API \
                         ../../../Modules/Language/API
FILE_PATTERNS          = *.hxx
EXCLUDE_PATTERNS       = *_i.hxx
RECURSIVE              = NO
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES

# --- Sorties : uniquement le XML pour Breathe --------------------------------
GENERATE_HTML          = NO
GENERATE_LATEX         = NO
GENERATE_XML           = YES
XML_OUTPUT             = xml
XML_PROGRAMLISTING     = NO

# --- Prétraitement -----------------------------------------------------------
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = NO
SKIP_FUNCTION_MACROS   = YES

# --- Divers ------------------------------------------------------------------
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO
HAVE_DOT               = NO
INPUT_ENCODING         = UTF-8
